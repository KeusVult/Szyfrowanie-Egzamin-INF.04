<Window x:Class="_5Pi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5Pi"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#5F9EA0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Foreground="#FAEBD7" Content="Podaj wartość klucza" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="klucz" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="10,29,0,0"/>
        <Label Foreground="#FAEBD7" Content="Podaj tekst" Grid.Row="1" Grid.Column="0"/>
        <TextBox x:Name="wpiszSzyfr" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Width="350" Height="300" Grid.Row="1" Grid.Column="0"/>
        <Button Background="#ADD8E6" Content="Szyfruj" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="60" Click="Enscript" Grid.Column="1" Grid.Row="1"/>
        <Border Grid.Column="2" Grid.Row="1" BorderBrush="#FAEBD7" BorderThickness="8" CornerRadius="25" Width="350" Height="300">
            <TextBlock Foreground="#F0F8FF" x:Name="szyfr" HorizontalAlignment="Center"  TextWrapping="Wrap" Padding="15" Text="1" VerticalAlignment="Center" Width="350" Height="300" Grid.Column="2" Grid.Row="1" />
        </Border>
        <Button Content="Zapisz szyfr w pliku" Background="#ADD8E6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="120" Grid.Row="1" Grid.Column="2" Click="Save"/>
        <Label Content="Tekst Zaszyfrowany" Grid.Row="0" Grid.Column="2" Foreground="#FAEBD7"/>
    </Grid>
</Window>
